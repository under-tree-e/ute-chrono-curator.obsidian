{
  "name": "ute-chrono-curator.obsidian",
  "title": "UTE Chrono Curator",
  "version": "0.0.2-dev.12",
  "description": "UTE Chrono Curator - time tracker & organization module for Obsidian application",
  "author": {
    "name": "Under Tree Entertainment",
    "url": "https://under-tree-e.com",
    "email": "under-tree-e@outlook.com",
    "twitter": "under_tree_e",
    "linkedin": "under-tree-e"
  },
  "homepage": "https://github.com/under-tree-e/ute-chrono-curator.obsidian#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/under-tree-e/ute-chrono-curator.obsidian"
  },
  "bugs": {
    "url": "https://github.com/under-tree-e/ute-chrono-curator.obsidian/issues"
  },
  "keywords": [
    "time",
    "timetrack",
    "typescript",
    "es5",
    "obsidian"
  ],
  "license": "MIT",
  "private": false,
  "scripts": {
    "start": "tsnd -r tsconfig-paths/register src/main.ts",
    "prod": "node dist/build/server/main.js",
    "build-wp": "NODE_ENV=production webpack",
    "webpack": "webpack",
    "---": "",
    "load": "npm i --force",
    "fix": "npm audit fix --force",
    "update": "ncu --upgrade && npm run install && npm run fix",
    "rebuild": "npm rebuild",
    "----": "",
    "build": "npx ts-node node_scripts --build",
    "publish": "npx ts-node node_scripts --publish",
    "-----": "",
    "major-update": "npm version major --no-git-tag-version",
    "minor-update": "npm version minor --no-git-tag-version",
    "patch-update": "npm version patch --no-git-tag-version",
    "dev-update": "npm version prerelease --preid=dev --no-git-tag-version && git add . && git commit -m 'dev_update_'$npm_package_version && git push --all"
  },
  "dependencies": {
    "chart.js": "^4.4.3",
    "moment": "^2.30.1"
  },
  "devDependencies": {
    "@tsconfig/svelte": "^5.0.4",
    "bestzip": "^2.2.1",
    "clear-folder": "^5.0.0",
    "copy-webpack-plugin": "^12.0.2",
    "dotenv": "^16.4.5",
    "node-loader": "^2.0.0",
    "npm-check-updates": "^16.14.14",
    "obsidian": "^1.6.6",
    "sass": "^1.77.8",
    "sass-loader": "^14.2.1",
    "svelte": "^4.2.18",
    "svelte-loader": "^3.2.3",
    "svelte-preprocess": "^6.0.2",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "tsconfig-paths-webpack-plugin": "^4.1.0",
    "tslib": "^2.6.2",
    "typescript": "~5.3.3",
    "webpack": "^5.93.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.4",
    "webpack-node-externals": "^3.0.0"
  }
}
